# ─────────────────────────────────────────────────────────────────────────────
# Ryma Kiné — Admin System Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Admin password hash (bcrypt, cost factor 12)
# Generate with:
#   node scripts/hash-password.mjs YOUR_ADMIN_PASSWORD
ADMIN_PASSWORD_HASH=

# Owner Analytics Step-Up password hash (bcrypt, cost factor 12)
# Protects financial metrics, accounting receipts, and full database backups
# Generate with:
#   node scripts/hash-password.mjs YOUR_OWNER_PASSWORD
OWNER_ANALYTICS_PASSWORD_HASH=

# Session encryption secret (minimum 32 characters, random)
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# For a persistent single-server SQLite deployment, use an absolute mounted path.
# Serverless deployments must use Turso. Never put a database in the Git checkout.
# DATABASE_PATH=/var/lib/ryma/ryma.db
# ALLOW_SQLITE_FALLBACK=true

# Public clinic details are compiled into the client bundle. Rebuild after changes.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CLINIC_PHONE=
NEXT_PUBLIC_CLINIC_EMAIL=
NEXT_PUBLIC_CLINIC_ADDRESS=
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_SUPPORT_EMAIL=
# Optional release identifier for support diagnostics (no secrets).
NEXT_PUBLIC_RELEASE_SHA=
NEXT_PUBLIC_CLINIC_HOURS=
NEXT_PUBLIC_PROFESSIONAL_LICENSE=
NEXT_PUBLIC_CLINIC_NIF=
NEXT_PUBLIC_ERS_REGISTRATION=
# Set only behind Cloudflare with direct origin access blocked.
# TRUSTED_PROXY=cloudflare

# ─────────────────────────────────────────────────────────────────────────────
# Email System (Gmail SMTP or any standard SMTP — Zero custom domain required)
# ─────────────────────────────────────────────────────────────────────────────
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM_NAME="Ryma Ouichka — Kinésithérapie & Soins"
ADMIN_NOTIFICATION_EMAIL=your_email@gmail.com

# ─────────────────────────────────────────────────────────────────────────────
# Turso Cloud Database (Required for Serverless / Vercel Deployments)
# Create a free DB at: https://turso.tech
# ─────────────────────────────────────────────────────────────────────────────
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Google reCAPTCHA v3 (Invisible Bot Protection for Booking Form)
# Register your domain at: https://www.google.com/recaptcha/admin/create
# Select "reCAPTCHA v3"
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# WhatsApp booking — keep disabled until Meta onboarding and the retry job are ready.
# Clinic number: +351 933 467 880. This is NOT the Meta phone-number ID below.
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Use a supported Graph API version shown in your Meta app, e.g. vNN.0.
WHATSAPP_GRAPH_VERSION=
# Random secret for POST /api/whatsapp/jobs (Authorization: Bearer <secret>).
# Schedule every minute using your hosting provider's scheduler.
WHATSAPP_JOB_SECRET=
# Default matches existing website booking requests. true = immediate confirmation.
WHATSAPP_AUTO_CONFIRM=false
# Optional test-patient allowlist: comma-separated international digits, without +.
# Use another WhatsApp number to message the clinic number during testing.
WHATSAPP_ALLOWED_SENDERS=
